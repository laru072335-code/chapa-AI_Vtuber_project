{
    //.jsoncにすることでコメントがjsonのファイルの中にかける
    "Speaker": 46, //voicevoxのspeakerのID
    "AI_model": "ollama_chat/gemma4:e2b-mlx", //使用するLLM   <エンジン名>/<モデル名>で指定。エンジン名に関してはこのサイトの自分が使うエンジンの説明をよく参考にして、指定すること。https://docs.litellm.ai/docs/providers
    "Max_queue_size": 20, //非同期に使用しているキューの最大容量
    "Output": "Unity", //outputの設定  音声とテキストを出力する場合、Sound、テキストのみの場合、Text、Unity(GUI)の場合、Unityに設定
    "Socialstream_path": "", //Mac以外の場合で必要なsocialstreamのパス名
    "SoundEngine": "voicevox", //音声合成をどのツールで動かすかを指定
    "SoundEngine_path": "", //Mac以外の場合で必要なvoicevoxのパス名
    "Input_type": "socialstream", //何の種類のinputを使うのかを指定する、この時streamを選択すると、他にも様々な設定が必要なことに注意
    "DB_API": "https://chapa-otmv1j8up-chapa3.vercel.app", //ネット上のデータベースにアクセスするためのURLを指定する
    "WEB_URL": "https://commentsite.vercel.app", //ログイン処理などをしているサイト（コメントサイトのURL）
    "stream_id": 1, //配信モードで動かす時に必要な配信を区別するためのid
    "stream_name": "aaa"
}
